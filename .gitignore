# generic files to ignore
.*

# ...except these. The rule above matches every dotfile at every level, so in a
# freshly initialised repository it silently drops the project's own
# configuration -- including .gitignore itself, which then never reaches the
# remote and stops protecting the clone. Anything dot-prefixed that must be
# versioned has to be re-included here.
!.gitignore
!.gitattributes
!.gitmodules
!.git-blame-ignore-revs
!.clang-format
!.clang-tidy
!.editorconfig
!.well-known/

# Deliberately still ignored by the rule above: .claude/ (local agent settings),
# .vscode/, .idea/, .gradle/, .venv/ and the various tool caches.

# python temp paths
__pycache__/
*.py[cod]

# editors
*~
*.swp
*.swo
*#

# Indexes for emacs, vi & others
TAGS
tags

# QtCreator
CMakeLists.txt.user

# ms-windows
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# commonly used paths in blender
/blender.bin
/BUILD_NOTES.txt

# local patches
/*.patch
/*.diff

# in-source doc-gen
/doc/doxygen/html/
/doc/python_api/sphinx-in-tmp/
/doc/python_api/sphinx-in/
/doc/python_api/sphinx-out/
/doc/python_api/stubs/
/doc/python_api/rst/bmesh.ops.rst

# in-source lib downloads and staging
/build_files/build_environment/downloads/
/build_files/build_environment/windows/build/

# in-source buildbot signing configuration
/build_files/buildbot/codesign/config_server.py

# smoke simulation noise tile (generated)
waveletNoiseTile.bin

# testing environment
/Testing/

# Translations.
/locale/user-config.py

# External repositories.
/scripts/addons/
/scripts/addons_contrib/
/tests/benchmarks/

# Ignore old submodules directories.
# Eventually need to get rid of those, but for the first time of transition
# avoid indidents when the folders exists after bisect and developers staging
# them by accident.
/release/scripts/addons/
/release/datafiles/locale/
/release/scripts/addons_contrib/
/source/tools/
/release/datafiles/assets/
/tests/data/
/lib/macos_x64/

# Build files for VS and VS Code.
/build/
/install/
/out/
CMakeSettings.json
CMakePresets.json
CMakeUserPresets.json

# Compile commands generated by CMake that may be linked into the source code
# folder to make it easier for tools like clangd to discover.
compile_commands.json

# Temporary Blender files.
blendcache_*
*.blend1
*.blend2

# -----------------------------------------------------------------------------
# Blender Android local build products.
#
# The canonical Android source stays in this repository. Cross-compiled
# dependencies, CMake/Ninja trees, APK stages and signed packages are local
# products and must never be committed.
/blender_build_android/
/android_deps_build/
/build_android*/
/build_host_tools*/
/android_apk_stage_*/
/deps_arm64/
/deps_x64/

# CMake/Ninja products accidentally created inside the source tree.
CMakeCache.txt
CMakeFiles/
build.ninja
rules.ninja
.ninja_deps
.ninja_log
cmake_install.cmake
install_manifest.txt

# Android SDK/NDK, Gradle and IDE state must remain external to the repository.
/android-sdk/
/Android/Sdk/
.gradle/
.idea/
.vscode/
local.properties
gradle.properties

# Packages, signatures and native diagnostics.
*.apk
*.aab
*.apks
*.idsig
*.profraw
*.profdata
*.trace
*.tombstone

# Signing material and credentials. Release keys must be supplied from a path
# outside the checkout, never copied into the project.
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.der
*.mobileprovision
.env
.env.*
credentials.*
secrets.*

# Android test captures and temporary investigation files at repository root.
/blender_*.png
/blender_*.xml
/.tmp_*
/*.log
/*.pid

# WSL/editor filesystem artifacts.
*.Zone.Identifier
*.stackdump
*~

# -----------------------------------------------------------------------------
# Heavy upstream content that is fetched, not versioned here.
#
# Together these are ~3.1 GB of the 3.8 GB working tree. Excluding them is what
# keeps a clone of this fork practical; both are recoverable from upstream.

# Precompiled Blender dependencies. Upstream ships them as submodules -- see
# .gitmodules, which stays tracked so they can be fetched again:
#   git submodule update --init lib/linux_x64
# 2.3 GB of binaries, and on a Windows checkout their symlinks arrive as broken
# stub files anyway (see ANDROID_BUILD_GUIDE.md, section 15.3).
/lib/

# Binary regression-test assets: ~790 MB of .blend scenes, videos and images.
# Not needed to build, package or run the Android port. Restore from upstream
# only if the automated test suite is actually going to be run.
/tests/files/

# git-lfs writes its hooks to a literal path instead of .git/hooks, so a
# directory named after the null device keeps reappearing: NUL on Windows,
# dev/null here. Both are ignored: NUL used to be tracked, and since NUL is a
# reserved device name on Windows, git refused to check the tree out there at
# all, so cloning the repository on Windows failed outright. This stops the
# spelling from being offered up for commit on every build.
/dev/
/NUL/

# Patch/merge leftovers.
*.orig
*.rej

# Node tooling, if a web-based doc or asset step is ever added here.
node_modules/
