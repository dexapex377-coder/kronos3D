<!-- Kronos3D launcher screen.

     Landscape: this device is 2400x1080, about 800x360dp, so the content is a
     two-column card centred on a gradient backdrop, inside a ScrollView. A
     single stacked column overran the 360dp of height and pushed the button to
     the very bottom edge, and match_parent children stretched across the whole
     2400px. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/launcher_panel"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingVertical="20dp">

        <!-- Identity -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingEnd="22dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/logo_frame"
                android:padding="10dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.03"
                android:text="Kronos3D"
                android:textColor="@color/k3d_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:letterSpacing="0.14"
                android:text="3D CREATION SUITE"
                android:textColor="@color/k3d_blue"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="22dp"
            android:background="#2E4361" />

        <!-- Version, launch, legal -->
        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/launcher_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/version_pill"
                android:letterSpacing="0.04"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:textColor="@color/k3d_text_primary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Unofficial Blender port for Android"
                android:textColor="@color/k3d_text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/launcher_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/launch_button"
                android:letterSpacing="0.02"
                android:text="Launch Kronos3D"
                android:textAllCaps="false"
                android:textColor="@color/k3d_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/launcher_credits"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/credits_button"
                android:text="Credits"
                android:textAllCaps="false"
                android:textColor="@color/k3d_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Unofficial port — not affiliated\nwith the Blender Foundation"
                android:textColor="@color/k3d_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
