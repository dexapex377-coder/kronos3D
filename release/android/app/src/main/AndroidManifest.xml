<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          android:versionCode="0"
          android:versionName="1.0"
          android:installLocation="auto">

    <!-- Vulkan requirement, setting at level 0 to maximize possible compatibility. -->
    <uses-feature
            android:name="android.hardware.vulkan.level"
            android:version="0"
            android:required="true"/>

    <!-- Touchscreen support. -->
    <uses-feature
            android:name="android.hardware.touchscreen"
            android:required="false"/>

    <!-- External mouse input events. -->
    <uses-feature
            android:name="android.hardware.type.pc"
            android:required="false"/>

    <!-- Network permission, used for both user online access and Tracy remote profiling. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Blender reads and writes .blend files and their assets by path, so it needs access to
         shared storage rather than the scoped, app-private sandbox (all-files access). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application android:label="@string/app_name"
                 android:icon="@mipmap/ic_launcher"
                 android:roundIcon="@mipmap/ic_launcher_round"
                 android:allowBackup="false"
                 android:hasFragileUserData="true"
                 android:theme="@style/AppTheme"
                 android:enableOnBackInvokedCallback="false"
                 android:hardwareAccelerated="true">

        <activity android:name="org.blender.blender.BlenderActivity"
                  android:label="@string/app_name"
                  android:alwaysRetainTaskState="true"
                  android:launchMode="singleInstance"
                  android:screenOrientation="userLandscape"
                  android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
                  android:preferMinimalPostProcessing="true"
                  android:exported="true"
        >
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Open a .blend file from an Android file browser, using both the .blend and generic binary MIME types. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content" android:mimeType="application/x-blender"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content" android:mimeType="application/octet-stream"/>
            </intent-filter>
        <!-- Load libblender.so via the NDK's native_app_glue, which is what makes
                 BlenderActivity (a NativeActivity subclass) start android_main(). -->
            <meta-data android:name="android.app.lib_name" android:value="blender"/>
        </activity>
    </application>

</manifest>
